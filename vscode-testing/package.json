{
  "name": "@jetbrains/vscode-testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test/vscode-stub": "./test/vscode-stub.mjs"
  },
  "scripts": {
    "test": "NODE_OPTIONS=\"--import ./test/vscode-stub.mjs\" node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jetbrains/vscode-extension-core": "workspace:*",
    "vscode-languageclient": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/vscode": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
