{
  "name": "kotlin-server",
  "displayName": "Kotlin by JetBrains",
  "version": "0.0.1",
  "description": "Language Support for Kotlin by JetBrains",
  "categories": [
    "Debuggers",
    "Formatters",
    "Linters",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "intellij",
    "jetbrains",
    "kotlin",
    "language server",
    "lsp"
  ],
  "bugs": "https://github.com/Kotlin/kotlin-lsp",
  "license": "SEE LICENSE IN LICENSE.txt",
  "author": "JetBrains",
  "repository": {
    "url": "https://github.com/Kotlin/kotlin-lsp",
    "directory": "kotlin-vscode"
  },
  "publisher": "JetBrains",
  "type": "module",
  "main": "./out/dist/extension.js",
  "scripts": {
    "compile": "rspack build --mode development",
    "watch": "rspack build --mode development --watch",
    "package": "rspack build --mode production --devtool hidden-source-map",
    "unpack-server": "node unpack-server.mjs",
    "test": "pnpm run test:grammar && pnpm run test:unit",
    "test:grammar": "textmate-grammar-snap --grammar syntaxes/kotlin.tmLanguage.json --scope source.kotlin \"testSources/tokenization/*.kt\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "pnpm --filter @jetbrains/vscode-extension-core test && pnpm --filter @jetbrains/vscode-language-kotlin test",
    "updateGrammarTests": "textmate-grammar-snap --grammar syntaxes/kotlin.tmLanguage.json --scope source.kotlin -u \"testSources/tokenization/*.kt\""
  },
  "dependencies": {
    "@jetbrains/vscode-extension-core": "workspace:*",
    "@jetbrains/vscode-language-kotlin": "workspace:*",
    "vscode-languageclient": "catalog:",
    "web-tree-sitter": "catalog:"
  },
  "devDependencies": {
    "@jetbrains/intellij-vscode-extension-policy": "workspace:*",
    "@rspack/cli": "catalog:",
    "@rspack/core": "catalog:",
    "@types/node": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "textmate-grammar-test": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vscode-languageserver-types": "catalog:"
  },
  "contributes": {
    "icons": {
      "jetbrains-ij": {
        "description": "JetBrains Kotlin status bar icon",
        "default": {
          "fontPath": "./out/dist/icons/lsp.woff",
          "fontCharacter": "\\E903"
        }
      },
      "jetbrains-ij-crossed": {
        "description": "JetBrains Kotlin status bar icon for problem states",
        "default": {
          "fontPath": "./out/dist/icons/lsp.woff",
          "fontCharacter": "\\E902"
        }
      }
    },
    "languages": [
      {
        "id": "kotlin",
        "aliases": [
          "Kotlin",
          "kotlin"
        ],
        "extensions": [
          ".kt"
        ],
        "configuration": "./syntaxes/language-configuration-kotlin.json"
      }
    ],
    "grammars": [
      {
        "language": "kotlin",
        "scopeName": "source.kotlin",
        "path": "./syntaxes/kotlin.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.kotlin"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "kotlin"
      }
    ],
    "taskDefinitions": [
      {
        "type": "intellij_build",
        "required": [],
        "properties": {
          "file": {
            "type": "string",
            "description": "Path to a file whose module to compile. Supports ${file}; a relative path is resolved against the workspace folder. Without it, the module of the active editor's file is compiled. A launch that references the \"intellij: build\" task compiles its own module, so it needs nothing here."
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "intellij_jvm",
        "label": "IntelliJ JVM Debugger",
        "languages": [
          "kotlin"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "mainClass"
            ],
            "properties": {
              "mainClass": {
                "type": "string",
                "description": "Fully-qualified name of the main class to run."
              },
              "file": {
                "type": "string",
                "description": "Path to the source file declaring the main class. Used to launch directly from a file, and to disambiguate when the main class name is declared in more than one file. Supports ${file}."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments passed to the main class."
              },
              "vmArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "JVM arguments."
              },
              "classPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Class path to run with. If empty, the LSP server resolves it from the project model."
              },
              "modulePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "JPMS module path to run with. If empty, the LSP server resolves it from the project model when the main class belongs to a named Java module."
              },
              "moduleName": {
                "type": "string",
                "description": "Name of the JPMS module that owns the main class, launched as `-m moduleName/mainClass`. If empty, the LSP server resolves it from the project model."
              },
              "javaExec": {
                "type": "string",
                "description": "Path to the java executable. If empty, the project SDK is used."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched process.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for the launched process."
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "enumDescriptions": [
                  "Run in the Debug Console (the language server launches the process).",
                  "Run in the integrated terminal (the editor launches the process and the debugger attaches).",
                  "Run in an external terminal (the debugger attaches)."
                ],
                "default": "integratedTerminal",
                "description": "Where to run the program."
              }
            }
          },
          "attach": {
            "required": [
              "port"
            ],
            "properties": {
              "hostName": {
                "type": "string",
                "description": "Host the JVM is listening on.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "JDWP port the JVM is listening on.",
                "default": 5005
              },
              "timeout": {
                "type": "number",
                "description": "Connection timeout in milliseconds.",
                "default": 30000
              }
            }
          }
        },
        "initialConfigurations": [],
        "configurationSnippets": [
          {
            "label": "IntelliJ: Launch main class (JVM)",
            "description": "Compile a JVM main class's module with the project's build tool, then run it as a plain java process. Remove \"preLaunchTask\" to launch whatever is already compiled.",
            "body": {
              "name": "${2:Run main}",
              "type": "intellij_jvm",
              "request": "launch",
              "mainClass": "${1:com.example.Main}",
              "preLaunchTask": "intellij: build",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "IntelliJ: Attach to JVM",
            "description": "Attach to a running JVM over JDWP via the IntelliJ LSP.",
            "body": {
              "name": "${1:Attach to JVM}",
              "type": "intellij_jvm",
              "request": "attach",
              "hostName": "${2:localhost}",
              "port": 5005
            }
          }
        ]
      },
      {
        "type": "intellij_debugger",
        "label": "IntelliJ JVM Debugger (deprecated: use intellij_jvm)",
        "configurationAttributes": {
          "launch": {
            "required": [
              "mainClass"
            ],
            "properties": {
              "mainClass": {
                "type": "string",
                "description": "Fully-qualified name of the main class to run."
              },
              "file": {
                "type": "string",
                "description": "Path to the source file declaring the main class. Used to launch directly from a file, and to disambiguate when the main class name is declared in more than one file. Supports ${file}."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments passed to the main class."
              },
              "vmArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "JVM arguments."
              },
              "classPaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Class path to run with. If empty, the LSP server resolves it from the project model."
              },
              "modulePaths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "JPMS module path to run with. If empty, the LSP server resolves it from the project model when the main class belongs to a named Java module."
              },
              "moduleName": {
                "type": "string",
                "description": "Name of the JPMS module that owns the main class, launched as `-m moduleName/mainClass`. If empty, the LSP server resolves it from the project model."
              },
              "javaExec": {
                "type": "string",
                "description": "Path to the java executable. If empty, the project SDK is used."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched process.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for the launched process."
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "enumDescriptions": [
                  "Run in the Debug Console (the language server launches the process).",
                  "Run in the integrated terminal (the editor launches the process and the debugger attaches).",
                  "Run in an external terminal (the debugger attaches)."
                ],
                "default": "integratedTerminal",
                "description": "Where to run the program."
              }
            }
          },
          "attach": {
            "required": [
              "port"
            ],
            "properties": {
              "hostName": {
                "type": "string",
                "description": "Host the JVM is listening on.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "JDWP port the JVM is listening on.",
                "default": 5005
              },
              "timeout": {
                "type": "number",
                "description": "Connection timeout in milliseconds.",
                "default": 30000
              }
            }
          }
        },
        "initialConfigurations": [],
        "configurationSnippets": []
      },
      {
        "type": "intellij_gradle",
        "label": "IntelliJ Gradle Debugger",
        "languages": [
          "kotlin"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "mainClass"
            ],
            "properties": {
              "mainClass": {
                "type": "string",
                "description": "Fully-qualified name of the main class to run."
              },
              "file": {
                "type": "string",
                "description": "Path to the source file declaring the main class. Used to launch directly from a file, and to disambiguate when the main class name is declared in more than one file. Supports ${file}."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Program arguments passed to the main class."
              },
              "vmArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "JVM arguments for the program Gradle forks. Not arguments for Gradle itself; use \"gradleArgs\" for those."
              },
              "projectPath": {
                "type": "string",
                "description": "Gradle project to run in, as Gradle names it (\":app\", \":modules:lib\"). If empty, the project the module was imported from is used."
              },
              "sourceSet": {
                "type": "string",
                "description": "Gradle source set whose runtime classpath the program runs on (\"main\", \"test\", \"integrationTest\"). If empty, the source set the module belongs to is used."
              },
              "gradleArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the Gradle invocation itself (\"--offline\", \"-Pkey=value\"). Arguments for the program go in \"args\", and for its JVM in \"vmArgs\"."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched program. If empty, Gradle’s own default for the project is used."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables for the launched program. Applied to the process Gradle forks, not to the Gradle invocation."
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "enumDescriptions": [
                  "Run in the Debug Console (the language server launches the process).",
                  "Run in the integrated terminal (the editor launches the process and the debugger attaches).",
                  "Run in an external terminal (the debugger attaches)."
                ],
                "default": "integratedTerminal",
                "description": "Where to run the program."
              }
            }
          }
        },
        "initialConfigurations": [],
        "configurationSnippets": [
          {
            "label": "IntelliJ: Launch main class (Gradle)",
            "description": "Compile and run a JVM main class through Gradle, in the integrated terminal.",
            "body": {
              "name": "${2:Run main}",
              "type": "intellij_gradle",
              "request": "launch",
              "mainClass": "${1:com.example.Main}"
            }
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "Kotlin by JetBrains",
        "properties": {
          "intellij.dev.serverPort": {
            "type": "number",
            "default": -1,
            "markdownDescription": "Port for a locally started language server. Specify `-1` to use the bundled server."
          },
          "intellij.dev.serverTimeoutMs": {
            "type": "number",
            "default": 10000,
            "description": "Timeout (ms) for connecting to an external language server"
          },
          "intellij.dev.commands": {
            "type": "boolean",
            "default": false,
            "description": "Exposes developer-only commands"
          },
          "intellij.additionalJvmArgs": {
            "type": "array",
            "default": [],
            "description": "Additional JVM arguments to pass to the language server"
          },
          "intellij.buildTool": {
            "type": "string",
            "default": null,
            "markdownDescription": "Build tool to use when importing projects. Select `null` to detect the build tool automatically or `\"\"` to disable project import."
          },
          "intellij.workspace.reloadOnBuildFileSave": {
            "type": "string",
            "scope": "window",
            "enum": [
              "always",
              "prompt",
              "never"
            ],
            "enumItemLabels": [
              "Always",
              "Prompt",
              "Never"
            ],
            "enumDescriptions": [
              "Reload the workspace automatically after a build file is saved.",
              "Ask before the extension reloads the workspace.",
              "Do not reload the workspace after a build file is saved."
            ],
            "default": "always",
            "description": "Controls workspace reloads after a build file is saved."
          },
          "intellij.projects": {
            "type": "array",
            "default": [],
            "description": "Externally configured projects to import automatically. Each entry specifies a workspace root or build file together with the build tool to use.",
            "items": {
              "type": "object",
              "required": [
                "type",
                "path"
              ],
              "defaultSnippets": [
                {
                  "label": "Configured project",
                  "description": "Project workspace root or build file together with the build tool to import it with.",
                  "body": {
                    "type": "${1|gradle,maven,bazel,jps,gomodules,gomodules-recursive-scan,json|}",
                    "path": "file:///${2:path/to/project}"
                  }
                }
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "markdownDescription": "Build system or project format used to import and analyze this project. Possible values: `gradle`, `maven`, `bazel`, `jps`, `gomodules`, `gomodules-recursive-scan`, `json`.",
                  "enum": [
                    "gradle",
                    "maven",
                    "bazel",
                    "jps",
                    "gomodules",
                    "gomodules-recursive-scan",
                    "json"
                  ]
                },
                "path": {
                  "type": "string",
                  "markdownDescription": "URI of the project workspace root or build file. For example: `file:///proj-dir/pom.xml`."
                },
                "downloadAdditionalArtifacts": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether project import may download sources and documentation of dependencies"
                },
                "offline": {
                  "type": "boolean",
                  "default": false,
                  "description": "Whether project import uses only already downloaded artifacts"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "maven"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "env": {
                        "type": "object",
                        "description": "Additional environment variables to use during Maven project import",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "system-properties": {
                        "type": "object",
                        "description": "JVM system properties to use during Maven project import",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "java-home": {
                        "type": "string",
                        "description": "Path to the JDK used to run Maven project import"
                      },
                      "profiles": {
                        "type": "array",
                        "description": "Maven only: build profiles to activate during project import",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "env": false,
                      "system-properties": false,
                      "java-home": false,
                      "profiles": false
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "bazel"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "project-path": {
                        "type": "string",
                        "description": "Bazel only: path to the Bazel project file, relative to the workspace root."
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "project-path": false
                    }
                  }
                }
              ]
            }
          },
          "intellij.jdkForSymbolResolution": {
            "type": "string",
            "default": null,
            "description": "Path to the JDK used for symbol resolution"
          },
          "intellij.trace.server": {
            "scope": "window",
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Traces communication between VS Code and the language server"
          }
        }
      },
      {
        "title": "Data Sharing",
        "properties": {
          "intellij.region": {
            "type": "string",
            "scope": "application",
            "enum": [
              "africa",
              "americas",
              "apac",
              "china",
              "europe",
              "middle_east",
              "oceania",
              "not_set"
            ],
            "enumItemLabels": [
              "Africa",
              "Americas",
              "Asia (Except Mainland China)",
              "Mainland China",
              "Europe",
              "Middle East",
              "Oceania",
              "Select a region to continue"
            ],
            "default": "not_set",
            "description": "Region used for JetBrains product terms and data processing"
          },
          "intellij.dataSharing": {
            "type": "string",
            "scope": "application",
            "enum": [
              "full",
              "anonymous",
              "none",
              "not_set"
            ],
            "enumDescriptions": [
              "Send anonymous usage statistics and full error reports (including exception messages and attachments).",
              "Send anonymous usage statistics and anonymized error reports (messages and user data stripped).",
              "Do not send usage statistics or error reports.",
              "Select a data-sharing preference to continue."
            ],
            "default": "not_set",
            "markdownDescription": "Controls what diagnostic data the language server shares with JetBrains.\n\nThe following table shows the data sent at each level:\n\n| | Usage Data | Errors | Error Details (non-anonymized) |\n| --- | :---: | :---: | :---: |\n| `full` | ✓ | ✓ | ✓ |\n| `anonymous` | ✓ | ✓ | – |\n| `none` | – | – | – |"
          }
        }
      },
      {
        "title": "Inlay Hints",
        "properties": {
          "jetbrains.kotlin.hints.settings.types.property": {
            "type": "boolean",
            "default": true,
            "description": "Shows property types"
          },
          "jetbrains.kotlin.hints.settings.types.variable": {
            "type": "boolean",
            "default": true,
            "description": "Shows local variable types"
          },
          "jetbrains.kotlin.hints.type.function.return": {
            "type": "boolean",
            "default": true,
            "description": "Shows function return types"
          },
          "jetbrains.kotlin.hints.type.function.parameter": {
            "type": "boolean",
            "default": true,
            "description": "Shows function parameter types"
          },
          "jetbrains.kotlin.hints.settings.lambda.return": {
            "type": "boolean",
            "default": true,
            "description": "Shows return expressions"
          },
          "jetbrains.kotlin.hints.lambda.receivers.parameters": {
            "type": "boolean",
            "default": true,
            "description": "Shows implicit receivers and parameters"
          },
          "jetbrains.kotlin.hints.settings.value.ranges": {
            "type": "boolean",
            "default": true,
            "description": "Shows ranges"
          },
          "jetbrains.kotlin.hints.value.kotlin.time": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Shows `24h` hints for day-based `kotlin.time.Duration` expressions"
          },
          "jetbrains.kotlin.hints.parameters": {
            "type": "boolean",
            "default": true,
            "description": "Shows parameter names"
          },
          "jetbrains.kotlin.hints.parameters.compiled": {
            "type": "boolean",
            "default": true,
            "description": "Shows compiled parameter names"
          },
          "jetbrains.kotlin.hints.parameters.excluded": {
            "type": "boolean",
            "default": false,
            "description": "Shows excluded parameter names"
          },
          "jetbrains.kotlin.hints.call.chains": {
            "type": "boolean",
            "default": false,
            "description": "Shows function return types in call chains"
          }
        }
      },
      {
        "title": "File Templates",
        "markdownDescription": "Please check the [documentation](https://github.com/Kotlin/kotlin-lsp/blob/main/kotlin-vscode/docs/file_templates.md).",
        "properties": {
          "jetbrains.templates.kotlin.Class": {
            "type": "string",
            "editPresentation": "multilineText",
            "default": "#if (${PACKAGE_NAME} && ${PACKAGE_NAME} != \"\")package ${PACKAGE_NAME}\n\n#end\nclass ${NAME} {\n\t|\n}",
            "markdownDescription": "Please check the [documentation](https://github.com/Kotlin/kotlin-lsp/blob/main/kotlin-vscode/docs/file_templates.md)."
          },
          "jetbrains.templates.kotlin.File": {
            "type": "string",
            "editPresentation": "multilineText",
            "default": "#if (${PACKAGE_NAME} && ${PACKAGE_NAME} != \"\")package ${PACKAGE_NAME}\n\n#end\n|",
            "markdownDescription": "Please check the [documentation](https://github.com/Kotlin/kotlin-lsp/blob/main/kotlin-vscode/docs/file_templates.md)."
          },
          "jetbrains.templates.kotlin.Interface": {
            "type": "string",
            "editPresentation": "multilineText",
            "default": "#if (${PACKAGE_NAME} && ${PACKAGE_NAME} != \"\")package ${PACKAGE_NAME}\n\n#end\ninterface ${NAME} {\n\t|\n}",
            "markdownDescription": "Please check the [documentation](https://github.com/Kotlin/kotlin-lsp/blob/main/kotlin-vscode/docs/file_templates.md)."
          },
          "jetbrains.templates.kotlin.Data Class": {
            "type": "string",
            "editPresentation": "multilineText",
            "default": "#if (${PACKAGE_NAME} && ${PACKAGE_NAME} != \"\")package ${PACKAGE_NAME}\n\n#end\ndata class ${NAME}(|)\n",
            "markdownDescription": "Please check the [documentation](https://github.com/Kotlin/kotlin-lsp/blob/main/kotlin-vscode/docs/file_templates.md)."
          },
