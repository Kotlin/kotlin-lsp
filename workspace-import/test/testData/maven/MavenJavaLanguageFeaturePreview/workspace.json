{
    "modules": [
        {
            "name": "maven-java-language-feature-preview",
            "coordinate": "com.example:maven-java-language-feature-preview:1.0-SNAPSHOT",
            "dependencies": [
                {
                    "type": "inheritedSdk"
                },
                {
                    "type": "moduleSource"
                }
            ],
            "contentRoots": [
                {
                    "path": "<WORKSPACE>/",
                    "sourceRoots": [
                        {
                            "path": "<WORKSPACE>/src/main/java",
                            "type": "java-source"
                        },
                        {
                            "path": "<WORKSPACE>/src/main/resources",
                            "type": "java-resource"
                        },
                        {
                            "path": "<WORKSPACE>/src/test/java",
                            "type": "java-test"
                        },
                        {
                            "path": "<WORKSPACE>/src/test/resources",
                            "type": "java-test-resource"
                        }
                    ]
                }
            ],
            "externalProjectPath": "<WORKSPACE>/"
        }
    ],
    "javaSettings": [
        {
            "module": "maven-java-language-feature-preview",
            "inheritedCompilerOutput": false,
            "excludeOutput": false,
            "compilerOutputs": [
                "<WORKSPACE>/target/classes"
            ],
            "compilerOutputsForTests": [
                "<WORKSPACE>/target/test-classes"
            ],
            "languageLevelId": "JDK_25_PREVIEW",
            "manifestAttributes": {},
            "compilerArguments": [
                "--enable-preview"
            ]
        }
    ],
    "externalSystem": "MAVEN"
}