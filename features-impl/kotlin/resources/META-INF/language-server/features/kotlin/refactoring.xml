<idea-plugin>
  <extensions defaultExtensionNs="com.intellij">
    <refactoring.moveDirectoryWithClassesHelper
            id="kotlin.moveDirectoryWithClasses"
            implementation="org.jetbrains.kotlin.idea.k2.refactoring.move.processor.K2MoveDirectoryWithClassesHelper"/>
    <refactoring.moveClassHandler
            order="first"
            implementation="org.jetbrains.kotlin.idea.refactoring.move.MoveKotlinAliasClassHandler"/>
    <moveFileHandler
            id="kotlin.moveFiles"
            implementation="org.jetbrains.kotlin.idea.k2.refactoring.move.processor.K2MoveFilesHandler"/>

    <refactoring.overrideMethodProcessor implementation="org.jetbrains.kotlin.idea.refactoring.inline.KotlinOverrideMethodsProcessor"/>

    <!--Surround with, copied from intellij.kotlin.codeInsight.shared.xml-->
    <lang.surroundDescriptor
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.surroundWith.expression.KotlinExpressionSurroundDescriptor"/>
    <lang.surroundDescriptor
            language="kotlin"
            implementationClass="org.jetbrains.kotlin.idea.codeInsight.surroundWith.statement.KotlinStatementSurroundDescriptor"/>
    <codeInsight.surroundWithRangeAdjuster
            implementation="org.jetbrains.kotlin.idea.codeInsight.surroundWith.KotlinSurroundWithRangeAdjuster"/>
  </extensions>

  <extensions defaultExtensionNs="ls">
    <moveHandlerDelegate implementation="com.jetbrains.ls.api.features.impl.kotlin.move.LSKotlinMoveHandlerDelegate"/>
    <moveHandlerDelegate implementation="com.jetbrains.ls.api.features.impl.kotlin.move.LSJvmDirectoryMoveHandlerDelegate"/>
  </extensions>
</idea-plugin>